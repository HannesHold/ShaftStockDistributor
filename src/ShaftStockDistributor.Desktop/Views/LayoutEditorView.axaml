<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShaftStockDistributor.Desktop.ViewModels"
             xmlns:local="using:ShaftStockDistributor.Desktop"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="ShaftStockDistributor.Desktop.Views.LayoutEditorView"
             x:DataType="vm:LayoutEditorViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12" MaxWidth="1080">
      <TextBlock Text="{x:Static local:UiText.LayoutTitle}" Classes="h1" />
      <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
      <Border Background="Transparent" ToolTip.Tip="{Binding Lock.Hint}">
      <StackPanel Spacing="12" IsEnabled="{Binding Lock.CanMutate}">
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="{x:Static local:UiText.ShuttlesZones}" Classes="section" />
          <TextBlock Text="{x:Static local:UiText.ShuttleZoneHint}" Classes="muted" TextWrapping="Wrap" />
          <dg:DataGrid x:Name="ShuttleGrid"
                       ItemsSource="{Binding Shuttles}"
                       AutoGenerateColumns="False"
                       CanUserReorderColumns="False"
                       CanUserSortColumns="False"
                       GridLinesVisibility="Horizontal"
                       HorizontalScrollBarVisibility="Auto"
                       Height="168"
                       MinHeight="140">
            <dg:DataGrid.Columns>
              <dg:DataGridTextColumn Binding="{Binding Title}" IsReadOnly="True" Width="110" MinWidth="110">
                <dg:DataGridTextColumn.Header>
                  <TextBlock Text="Shuttle" />
                </dg:DataGridTextColumn.Header>
              </dg:DataGridTextColumn>
              <dg:DataGridTextColumn Binding="{Binding SegmentFrom, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" Width="84" MinWidth="84">
                <dg:DataGridTextColumn.Header>
                  <TextBlock Text="From" ToolTip.Tip="First segment this shuttle serves" />
                </dg:DataGridTextColumn.Header>
              </dg:DataGridTextColumn>
              <dg:DataGridTextColumn Binding="{Binding SegmentTo, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" Width="72" MinWidth="72">
                <dg:DataGridTextColumn.Header>
                  <TextBlock Text="To" ToolTip.Tip="Last segment this shuttle serves" />
                </dg:DataGridTextColumn.Header>
              </dg:DataGridTextColumn>
              <dg:DataGridTextColumn Binding="{Binding HorizontalSpeed, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" Width="110" MinWidth="110">
                <dg:DataGridTextColumn.Header>
                  <TextBlock Text="H speed" ToolTip.Tip="Horizontal speed (m/s)" />
                </dg:DataGridTextColumn.Header>
              </dg:DataGridTextColumn>
              <dg:DataGridTextColumn Binding="{Binding VerticalSpeed, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" Width="110" MinWidth="110">
                <dg:DataGridTextColumn.Header>
                  <TextBlock Text="V speed" ToolTip.Tip="Vertical speed (m/s)" />
                </dg:DataGridTextColumn.Header>
              </dg:DataGridTextColumn>
              <dg:DataGridTextColumn Binding="{Binding HorizontalAcceleration, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" Width="110" MinWidth="110">
                <dg:DataGridTextColumn.Header>
                  <TextBlock Text="H accel" ToolTip.Tip="Horizontal acceleration (m/s²)" />
                </dg:DataGridTextColumn.Header>
              </dg:DataGridTextColumn>
              <dg:DataGridTextColumn Binding="{Binding VerticalAcceleration, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" Width="110" MinWidth="110">
                <dg:DataGridTextColumn.Header>
                  <TextBlock Text="V accel" ToolTip.Tip="Vertical acceleration (m/s²)" />
                </dg:DataGridTextColumn.Header>
              </dg:DataGridTextColumn>
              <dg:DataGridTextColumn Binding="{Binding HomeX, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" Width="110" MinWidth="110">
                <dg:DataGridTextColumn.Header>
                  <TextBlock Text="Home X" ToolTip.Tip="Home position along the aisle (m)" />
                </dg:DataGridTextColumn.Header>
              </dg:DataGridTextColumn>
              <dg:DataGridTextColumn Binding="{Binding HomeLevel, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" Width="120" MinWidth="120">
                <dg:DataGridTextColumn.Header>
                  <TextBlock Text="Home level" ToolTip.Tip="Home level" />
                </dg:DataGridTextColumn.Header>
              </dg:DataGridTextColumn>
            </dg:DataGrid.Columns>
          </dg:DataGrid>
          <WrapPanel>
            <Button Content="{x:Static local:UiText.AddShuttle}" Command="{Binding AddShuttleCommand}" Margin="0,0,8,6" />
            <Button Content="{x:Static local:UiText.RemoveShuttle}" Command="{Binding RemoveShuttleCommand}" Margin="0,0,8,6" />
            <Button Content="{x:Static local:UiText.EvenSplit}" Command="{Binding EvenSplitCommand}" Margin="0,0,8,6" />
            <Button Content="{x:Static local:UiText.TwoShuttlePreset}" Command="{Binding TwoShuttleThirdsCommand}" Margin="0,0,8,6" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Static local:UiText.NavLayout}" Classes="section" />
          <WrapPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="{x:Static local:UiText.Segments}" Classes="field" />
              <TextBox Text="{Binding SegmentCount, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="{x:Static local:UiText.Levels}" Classes="field" />
              <TextBox Text="{Binding Levels, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="{x:Static local:UiText.ShaftsPerLevel}" Classes="field" />
              <TextBox Text="{Binding ShaftsPerLevel, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="{x:Static local:UiText.ShaftLength}" Classes="field" />
              <TextBox Text="{Binding ShaftLength, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="{x:Static local:UiText.CrateGap}" Classes="field" />
              <TextBox Text="{Binding CrateGap, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="{x:Static local:UiText.Pitch}" Classes="field" />
              <TextBox Text="{Binding Pitch, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="{x:Static local:UiText.LevelHeight}" Classes="field" />
              <TextBox Text="{Binding LevelHeight, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="{x:Static local:UiText.SegmentGap}" Classes="field" />
              <TextBox Text="{Binding SegmentGap, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="{x:Static local:UiText.ShaftWidth}" Classes="field" />
              <TextBox Text="{Binding ShaftWidth, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="{x:Static local:UiText.ShaftHeight}" Classes="field" />
              <TextBox Text="{Binding ShaftHeight, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="{x:Static local:UiText.Transfer}" Classes="field" />
              <TextBox Text="{Binding Transfer, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="{x:Static local:UiText.Safety}" Classes="field" />
              <TextBox Text="{Binding Safety, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Button Classes="accent" HorizontalAlignment="Left" Content="{x:Static local:UiText.ApplyLayout}" Command="{Binding ApplyCommand}" Click="CommitShuttleGrid" />
      </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
