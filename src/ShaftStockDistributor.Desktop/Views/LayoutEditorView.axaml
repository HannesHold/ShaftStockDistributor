<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShaftStockDistributor.Desktop.ViewModels"
             xmlns:local="using:ShaftStockDistributor.Desktop"
             x:Class="ShaftStockDistributor.Desktop.Views.LayoutEditorView"
             x:DataType="vm:LayoutEditorViewModel">
  <ScrollViewer>
    <StackPanel Spacing="14" MaxWidth="1080">
      <TextBlock Text="{x:Static local:UiText.LayoutTitle}" Classes="h1" />
      <TextBlock Text="{Binding Status}" Classes="muted" />
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Static local:UiText.NavLayout}" Classes="section" />
          <WrapPanel>
            <StackPanel Width="240" Margin="0,0,12,10">
              <TextBlock Text="{x:Static local:UiText.Segments}" Classes="field" />
              <TextBox Text="{Binding SegmentCount, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,12,10">
              <TextBlock Text="{x:Static local:UiText.Levels}" Classes="field" />
              <TextBox Text="{Binding Levels, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,12,10">
              <TextBlock Text="{x:Static local:UiText.ShaftsPerLevel}" Classes="field" />
              <TextBox Text="{Binding ShaftsPerLevel, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,12,10">
              <TextBlock Text="{x:Static local:UiText.ShaftLength}" Classes="field" />
              <TextBox Text="{Binding ShaftLength, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,12,10">
              <TextBlock Text="{x:Static local:UiText.CrateGap}" Classes="field" />
              <TextBox Text="{Binding CrateGap, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,12,10">
              <TextBlock Text="{x:Static local:UiText.Pitch}" Classes="field" />
              <TextBox Text="{Binding Pitch, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,12,10">
              <TextBlock Text="{x:Static local:UiText.LevelHeight}" Classes="field" />
              <TextBox Text="{Binding LevelHeight, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,12,10">
              <TextBlock Text="{x:Static local:UiText.SegmentGap}" Classes="field" />
              <TextBox Text="{Binding SegmentGap, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,12,10">
              <TextBlock Text="{x:Static local:UiText.ShaftWidth}" Classes="field" />
              <TextBox Text="{Binding ShaftWidth, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,12,10">
              <TextBlock Text="{x:Static local:UiText.ShaftHeight}" Classes="field" />
              <TextBox Text="{Binding ShaftHeight, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,12,10">
              <TextBlock Text="{x:Static local:UiText.Transfer}" Classes="field" />
              <TextBox Text="{Binding Transfer, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,12,10">
              <TextBlock Text="{x:Static local:UiText.Safety}" Classes="field" />
              <TextBox Text="{Binding Safety, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Classes="card" DataContext="{Binding Shuttle1}">
          <StackPanel Spacing="8" x:DataType="vm:ShuttleDraft" x:CompileBindings="False">
            <TextBlock Text="{x:Static local:UiText.Shuttle1}" Classes="section" />
            <TextBlock Text="{x:Static local:UiText.HorizontalSpeed}" Classes="field" />
            <TextBox Text="{Binding HorizontalSpeed, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.VerticalSpeed}" Classes="field" />
            <TextBox Text="{Binding VerticalSpeed, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.HorizontalAcceleration}" Classes="field" />
            <TextBox Text="{Binding HorizontalAcceleration, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.VerticalAcceleration}" Classes="field" />
            <TextBox Text="{Binding VerticalAcceleration, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.HomeX}" Classes="field" />
            <TextBox Text="{Binding HomeX, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.HomeLevel}" Classes="field" />
            <TextBox Text="{Binding HomeLevel, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.HandoverX}" Classes="field" />
            <TextBox Text="{Binding HandoverX, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.HandoverLevel}" Classes="field" />
            <TextBox Text="{Binding HandoverLevel, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card" DataContext="{Binding Shuttle2}">
          <StackPanel Spacing="8" x:DataType="vm:ShuttleDraft" x:CompileBindings="False">
            <TextBlock Text="{x:Static local:UiText.Shuttle2}" Classes="section" />
            <TextBlock Text="{x:Static local:UiText.HorizontalSpeed}" Classes="field" />
            <TextBox Text="{Binding HorizontalSpeed, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.VerticalSpeed}" Classes="field" />
            <TextBox Text="{Binding VerticalSpeed, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.HorizontalAcceleration}" Classes="field" />
            <TextBox Text="{Binding HorizontalAcceleration, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.VerticalAcceleration}" Classes="field" />
            <TextBox Text="{Binding VerticalAcceleration, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.HomeX}" Classes="field" />
            <TextBox Text="{Binding HomeX, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.HomeLevel}" Classes="field" />
            <TextBox Text="{Binding HomeLevel, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.HandoverX}" Classes="field" />
            <TextBox Text="{Binding HandoverX, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            <TextBlock Text="{x:Static local:UiText.HandoverLevel}" Classes="field" />
            <TextBox Text="{Binding HandoverLevel, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
          </StackPanel>
        </Border>
      </Grid>
      <Button Classes="accent" HorizontalAlignment="Left" Content="{x:Static local:UiText.ApplyLayout}" Command="{Binding ApplyCommand}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
