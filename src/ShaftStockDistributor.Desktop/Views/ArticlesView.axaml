<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShaftStockDistributor.Desktop.ViewModels"
             xmlns:local="using:ShaftStockDistributor.Desktop"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="ShaftStockDistributor.Desktop.Views.ArticlesView"
             x:DataType="vm:ArticlesViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{x:Static local:UiText.ArticlesTitle}" Classes="h1" VerticalAlignment="Center" />
        <Button Content="{x:Static local:UiText.AddArticle}" Command="{Binding AddCommand}" />
        <Button Content="{x:Static local:UiText.RemoveArticle}" Command="{Binding RemoveCommand}" />
        <TextBlock Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>

      <Border Background="Transparent" ToolTip.Tip="{Binding Lock.Hint}">
      <StackPanel Spacing="12" IsEnabled="{Binding Lock.CanMutate}">
      <Border Classes="card" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="{x:Static local:UiText.GeneratorTitle}" FontWeight="SemiBold" />
          <TextBlock Text="{x:Static local:UiText.GeneratorHint}" Classes="muted" TextWrapping="Wrap" />
          <WrapPanel>
            <StackPanel Width="130" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.ArticleCount}" Classes="field" />
              <TextBox Text="{Binding GenerateCount, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="120" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.PercentA}" Classes="field" />
              <TextBox Text="{Binding PercentA, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="120" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.PercentB}" Classes="field" />
              <TextBox Text="{Binding PercentB, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="120" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.PercentC}" Classes="field" />
              <TextBox Text="{Binding PercentC, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="140" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.OptionalSeed}" Classes="field" />
              <TextBox Text="{Binding SeedText, Mode=TwoWay}" />
            </StackPanel>
            <CheckBox Content="{x:Static local:UiText.ReplaceExisting}" IsChecked="{Binding ReplaceExisting}" VerticalAlignment="Bottom" Margin="0,0,10,12" />
            <Button Classes="accent" Content="{x:Static local:UiText.Generate}" Command="{Binding RequestGenerateCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
          </WrapPanel>
          <Border Background="#3A2A12" Padding="10" CornerRadius="8" IsVisible="{Binding ReplaceConfirmationVisible}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <StackPanel>
                <TextBlock Text="{x:Static local:UiText.GeneratorReplaceTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static local:UiText.GeneratorReplaceBody}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="accent" Content="{x:Static local:UiText.ReplaceArticles}" Command="{Binding ConfirmGenerateCommand}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Content="{x:Static local:UiText.Cancel}" Command="{Binding CancelGenerateCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <dg:DataGrid x:Name="ArticleGrid" x:CompileBindings="False" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="False" GridLinesVisibility="Horizontal" Height="240">
        <dg:DataGrid.Columns>
          <dg:DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="170" IsReadOnly="True" />
          <dg:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="160" IsReadOnly="True" />
          <dg:DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="80" IsReadOnly="True" />
          <dg:DataGridTextColumn Header="Inflow"
                                 Width="150"
                                 MinWidth="130"
                                 IsReadOnly="False"
                                 Binding="{Binding InflowCratesPerHour, Mode=TwoWay, Converter={StaticResource InvariantNumber}, ConverterParameter=0.##}" />
          <dg:DataGridTextColumn Header="Pallet" Binding="{Binding CratesPerPallet}" Width="90" IsReadOnly="True" />
          <dg:DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="90" IsReadOnly="True" />
        </dg:DataGrid.Columns>
      </dg:DataGrid>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <WrapPanel>
            <StackPanel Width="180" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.ArticleId}" Classes="field" />
              <TextBox Text="{Binding Draft.Id, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.ArticleName}" Classes="field" />
              <TextBox Text="{Binding Draft.Name, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Width="140" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.ClassLabel}" Classes="field" />
              <ComboBox ItemsSource="{Binding Classes}" SelectedItem="{Binding Draft.Class}" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.FlowAxis}" Classes="field" />
              <ComboBox ItemsSource="{Binding FlowAxes}" SelectedItem="{Binding Draft.Flow}" />
            </StackPanel>
            <StackPanel Width="120" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.Length}" Classes="field" />
              <TextBox Text="{Binding Draft.Length, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="120" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.Width}" Classes="field" />
              <TextBox Text="{Binding Draft.Width, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="120" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.Height}" Classes="field" />
              <TextBox Text="{Binding Draft.Height, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="150" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.CratesPerPallet}" Classes="field" />
              <TextBox Text="{Binding Draft.CratesPerPallet, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="130" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.Offset}" Classes="field" />
              <TextBox Text="{Binding Draft.Offset, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="120" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.Weight}" Classes="field" />
              <TextBox Text="{Binding Draft.ClassWeight, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="150" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.Inflow}" Classes="field" />
              <TextBox x:Name="ArticleInflowBox" Text="{Binding Draft.Inflow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InvariantNumber}}" />
            </StackPanel>
            <StackPanel Width="120" Margin="0,0,10,8">
              <TextBlock Text="{x:Static local:UiText.Color}" Classes="field" />
              <TextBox Text="{Binding Draft.Color, Mode=TwoWay}" />
            </StackPanel>
          </WrapPanel>
          <Button x:Name="ArticleApplyButton" Classes="accent" HorizontalAlignment="Left" Content="{x:Static local:UiText.Apply}" Click="CommitArticleGrid" Command="{Binding ApplyDraftCommand}" />
        </StackPanel>
      </Border>
      </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
