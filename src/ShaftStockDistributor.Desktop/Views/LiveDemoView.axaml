<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShaftStockDistributor.Desktop.ViewModels"
             xmlns:local="using:ShaftStockDistributor.Desktop"
             xmlns:controls="using:ShaftStockDistributor.Desktop.Controls"
             x:Class="ShaftStockDistributor.Desktop.Views.LiveDemoView"
             x:DataType="vm:LiveDemoViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="{x:Static local:UiText.NavLive}" Classes="h1" />
          <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="chip" IsVisible="{Binding SharedLocked}">
            <TextBlock Text="{x:Static local:UiText.SharedLock}" Foreground="#F0A202" />
          </Border>
          <Border Classes="chip" IsVisible="{Binding ShuttleWaiting}">
            <TextBlock Text="{x:Static local:UiText.Waiting}" Foreground="#E85D75" />
          </Border>
          <TextBlock Text="{Binding TimeText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <UniformGrid Columns="6">
        <Border Classes="card" Margin="0,0,6,0" Padding="8,6">
          <StackPanel Spacing="0">
            <TextBlock Text="{x:Static local:UiText.PalletsPerHour}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PalletsPerHourText}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RateCaption}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,6,0" Padding="8,6">
          <StackPanel Spacing="0">
            <TextBlock Text="{x:Static local:UiText.TotalPallets}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding TotalPalletsText}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding OpeningIncludedNote}" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasOpeningInventory}" />
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,6,0" Padding="8,6">
          <StackPanel Spacing="0">
            <TextBlock Text="{x:Static local:UiText.Offered}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding OfferedText}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,6,0" Padding="8,6">
          <ToolTip.Tip>
            <TextBlock MaxWidth="320" TextWrapping="Wrap" Text="{x:Static local:UiText.UpperBoundTip}" />
          </ToolTip.Tip>
          <StackPanel Spacing="0">
            <TextBlock Text="{x:Static local:UiText.TheoreticalCapacity}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding TheoreticalText}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,6,0" Padding="8,6">
          <StackPanel Spacing="0">
            <TextBlock Text="{x:Static local:UiText.Utilization}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding Util1Text, StringFormat='Shuttle 1 {0}'}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding Util2Text, StringFormat='Shuttle 2 {0}'}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="8,6">
          <StackPanel Spacing="0">
            <TextBlock Classes="muted" FontSize="12" Text="{Binding LostText, StringFormat='Lost {0}'}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding WaitText, StringFormat='Wait {0}'}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding PullsText, StringFormat='Pulls {0}'}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding BlockedText, StringFormat='Blocked {0}'}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Classes="card" Padding="4" MinHeight="300" Height="320">
        <controls:WarehouseCanvas Snapshot="{Binding Snapshot}"
                                  ShowHeatmap="{Binding ShowHeatmap}"
                                  SelectedAddress="{Binding SelectedAddress}"
                                  ShaftClickCommand="{Binding SelectShaftCommand}" />
      </Border>

      <ItemsControl ItemsSource="{Binding Legend}" Margin="4,0,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LegendItem">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,4">
              <Border Width="12" Height="12" CornerRadius="2" Background="{Binding ColorHex, Converter={StaticResource HexBrush}}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <WrapPanel>
        <Border Classes="card" Width="280" Margin="0,0,8,8" Padding="10">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static local:UiText.Playback}" FontWeight="SemiBold" />
            <WrapPanel>
              <Button Classes="accent" Content="{x:Static local:UiText.Play}" Command="{Binding PlayCommand}" Margin="0,0,8,6" />
              <Button Content="{x:Static local:UiText.Pause}" Command="{Binding PauseCommand}" Margin="0,0,8,6" />
              <Button Content="{x:Static local:UiText.Step}" Command="{Binding StepCommand}" Margin="0,0,8,6" />
              <Button Content="{x:Static local:UiText.Reset}" Command="{Binding ResetPlaybackCommand}" Margin="0,0,8,6" />
            </WrapPanel>
            <CheckBox Content="{x:Static local:UiText.Heatmap}" IsChecked="{Binding ShowHeatmap}" />
            <TextBlock Text="{x:Static local:UiText.Speed}" Classes="field" />
            <Slider Minimum="1" Maximum="400" Value="{Binding Speed}" />
          </StackPanel>
        </Border>
        <Border Classes="card" Width="280" Margin="0,0,8,8" Padding="10">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static local:UiText.SimulationSettings}" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <StackPanel>
                <TextBlock Text="{x:Static local:UiText.Seed}" Classes="field" />
                <TextBox Text="{Binding Seed, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Static local:UiText.RateWindow}" Classes="field" TextWrapping="Wrap" />
                <TextBox Text="{Binding RateWindowMinutes, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{x:Static local:UiText.Scenario}" Classes="field" />
            <ComboBox MinWidth="160" HorizontalAlignment="Stretch" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" />
            <Button HorizontalAlignment="Left" Content="{x:Static local:UiText.Apply}" Command="{Binding ApplyScenarioCommand}" />
          </StackPanel>
        </Border>
        <Border Classes="card" Width="280" Margin="0,0,8,8" Padding="10">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static local:UiText.ShaftAssignment}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedSummary}" TextWrapping="Wrap" />
            <ComboBox MinWidth="160" HorizontalAlignment="Stretch" ItemsSource="{Binding ArticleChoices}" SelectedItem="{Binding SelectedChoice}" />
            <CheckBox Content="{x:Static local:UiText.Pin}" IsChecked="{Binding SelectedPinned}" />
            <Button Classes="accent" HorizontalAlignment="Left" Content="{x:Static local:UiText.ApplyAssignment}" Command="{Binding ApplyShaftCommand}" />
          </StackPanel>
        </Border>
        <Border Classes="card" Width="340" Margin="0,0,0,8" Padding="10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{x:Static local:UiText.SteadyRate}" FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding RateCaption}" Classes="muted" Margin="0,2,0,6" TextWrapping="Wrap" />
            <controls:RateChart MinHeight="120"
                                Height="140"
                                Samples="{Binding RateSamples}"
                                Offered="{Binding OfferedRate}"
                                SpanMinutes="{Binding ChartSpanMinutes}" />
          </DockPanel>
        </Border>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
