<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShaftStockDistributor.Desktop.ViewModels"
             xmlns:local="using:ShaftStockDistributor.Desktop"
             xmlns:controls="using:ShaftStockDistributor.Desktop.Controls"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="ShaftStockDistributor.Desktop.Views.LiveDemoView"
             x:DataType="vm:LiveDemoViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel>
        <TextBlock Text="{x:Static local:UiText.NavLive}" Classes="h1" />
        <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Classes="chip" IsVisible="{Binding SharedLocked}">
          <TextBlock Text="{x:Static local:UiText.SharedLock}" Foreground="#F0A202" />
        </Border>
        <Border Classes="chip" IsVisible="{Binding ShuttleWaiting}">
          <TextBlock Text="{x:Static local:UiText.Waiting}" Foreground="#E85D75" />
        </Border>
        <TextBlock Text="{Binding TimeText}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <UniformGrid Grid.Row="1" Columns="6">
      <Border Classes="card" Margin="0,0,8,0" Padding="10">
        <StackPanel>
          <TextBlock Text="{x:Static local:UiText.PalletsPerHour}" Classes="muted" />
          <TextBlock Text="{Binding PalletsPerHourText}" Classes="kpi" />
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="0,0,8,0" Padding="10">
        <StackPanel>
          <TextBlock Text="{x:Static local:UiText.TotalPallets}" Classes="muted" />
          <TextBlock Text="{Binding TotalPalletsText}" Classes="kpi" />
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="0,0,8,0" Padding="10">
        <StackPanel>
          <TextBlock Text="{x:Static local:UiText.Offered}" Classes="muted" />
          <TextBlock Text="{Binding OfferedText}" Classes="kpi" />
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="0,0,8,0" Padding="10">
        <StackPanel>
          <TextBlock Text="{x:Static local:UiText.TheoreticalCapacity}" Classes="muted" />
          <TextBlock Text="{Binding TheoreticalText}" Classes="kpi" />
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="0,0,8,0" Padding="10">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Static local:UiText.Utilization}" Classes="muted" />
          <TextBlock Classes="muted" Text="{Binding Util1Text, StringFormat='Shuttle 1 {0}'}" />
          <TextBlock Classes="muted" Text="{Binding Util2Text, StringFormat='Shuttle 2 {0}'}" />
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="muted" Text="{Binding LostText, StringFormat='Lost crates {0}'}" />
          <TextBlock Classes="muted" Text="{Binding WaitText, StringFormat='Wait {0}'}" />
          <TextBlock Classes="muted" Text="{Binding PullsText, StringFormat='Pulls {0}'}" />
          <TextBlock Classes="muted" Text="{Binding BlockedText, StringFormat='Blocked {0}'}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Border Grid.Row="2" Classes="card" Padding="4">
      <controls:WarehouseCanvas Snapshot="{Binding Snapshot}"
                                ShowHeatmap="{Binding ShowHeatmap}"
                                SelectedAddress="{Binding SelectedAddress}"
                                ShaftClickCommand="{Binding SelectShaftCommand}" />
    </Border>

    <ItemsControl Grid.Row="3" ItemsSource="{Binding Legend}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:LegendItem">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,0">
            <Border Width="12" Height="12" CornerRadius="2" Background="{Binding ColorHex, Converter={StaticResource HexBrush}}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" Classes="muted" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid Grid.Row="4" ColumnDefinitions="*,280,280" ColumnSpacing="12">
      <Border Classes="card">
        <Grid ColumnDefinitions="*,280" ColumnSpacing="12">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="{x:Static local:UiText.Play}" Command="{Binding PlayCommand}" />
              <Button Content="{x:Static local:UiText.Pause}" Command="{Binding PauseCommand}" />
              <Button Content="{x:Static local:UiText.Step}" Command="{Binding StepCommand}" />
              <Button Content="{x:Static local:UiText.Reset}" Command="{Binding ResetPlaybackCommand}" />
              <CheckBox Content="{x:Static local:UiText.Heatmap}" IsChecked="{Binding ShowHeatmap}" VerticalAlignment="Center" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Text="{x:Static local:UiText.Speed}" Classes="field" />
                <Slider Minimum="1" Maximum="400" Value="{Binding Speed}" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Static local:UiText.Seed}" Classes="field" />
                <TextBox Text="{Binding Seed, Mode=TwoWay, Converter={StaticResource InvariantNumber}}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{x:Static local:UiText.Scenario}" Classes="field" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <ComboBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" />
                  <Button Grid.Column="1" Content="{x:Static local:UiText.Apply}" Command="{Binding ApplyScenarioCommand}" />
                </Grid>
              </StackPanel>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="{Binding SelectedSummary}" TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding ArticleChoices}" SelectedItem="{Binding SelectedChoice}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <CheckBox Content="{x:Static local:UiText.Pin}" IsChecked="{Binding SelectedPinned}" VerticalAlignment="Center" />
              <Button Classes="accent" Content="{x:Static local:UiText.ApplyAssignment}" Command="{Binding ApplyShaftCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <lvc:CartesianChart x:Name="PalletChart" Grid.Column="1" Height="132" Series="{Binding PalletSeries}" XAxes="{Binding TimeAxes}" YAxes="{Binding PalletAxes}" LegendPosition="Hidden" AnimationsSpeed="00:00:00" Background="Transparent" />
      <lvc:CartesianChart x:Name="UtilChart" Grid.Column="2" Height="132" Series="{Binding UtilSeries}" XAxes="{Binding TimeAxes}" YAxes="{Binding UtilAxes}" LegendPosition="Bottom" AnimationsSpeed="00:00:00" Background="Transparent" />
    </Grid>
  </Grid>
</UserControl>
