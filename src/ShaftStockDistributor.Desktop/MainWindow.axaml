<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShaftStockDistributor.Desktop.ViewModels"
        xmlns:local="using:ShaftStockDistributor.Desktop"
        x:Class="ShaftStockDistributor.Desktop.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{x:Static local:UiText.WindowTitle}"
        Icon="/Assets/app.ico"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#0E141B">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Background="#121A24" BorderBrush="#243140" BorderThickness="0,0,0,1" Padding="16,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Image Width="28" Height="28" Source="avares://ShaftStockDistributor.Desktop/Assets/app.png" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static local:UiText.AppTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Classes="badge" IsVisible="{Binding IsExample}">
              <TextBlock Text="{x:Static local:UiText.ExampleBadge}" />
            </Border>
          </StackPanel>
          <TextBlock Text="{x:Static local:UiText.Tagline}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{x:Static local:UiText.ConfigurationLocked}"
                     IsVisible="{Binding IsConfigurationLocked}"
                     TextWrapping="Wrap"
                     Foreground="#E7C27A"
                     FontSize="12"
                     ToolTip.Tip="{x:Static local:UiText.ConfigurationLocked}" />
        </StackPanel>
        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="760">
          <Button Content="{x:Static local:UiText.New}" Command="{Binding NewProjectCommand}" ToolTip.Tip="{x:Static local:UiText.TipNew}" Margin="0,0,8,4" />
          <Button Content="{x:Static local:UiText.Open}" Command="{Binding OpenProjectCommand}" ToolTip.Tip="{x:Static local:UiText.TipOpen}" Margin="0,0,8,4" />
          <Button Content="{x:Static local:UiText.OpenResult}" Command="{Binding OpenResultCommand}" ToolTip.Tip="{x:Static local:UiText.TipOpenResult}" Margin="0,0,8,4" />
          <Button Content="{x:Static local:UiText.Save}" Command="{Binding SaveProjectCommand}" ToolTip.Tip="{x:Static local:UiText.TipSave}" Margin="0,0,8,4" />
          <Button Content="{x:Static local:UiText.LoadExample}" Command="{Binding LoadExampleCommand}" ToolTip.Tip="{x:Static local:UiText.TipLoadExample}" Margin="0,0,8,4" />
          <Button Content="{x:Static local:UiText.ExportJson}" Command="{Binding ExportJsonCommand}" ToolTip.Tip="{x:Static local:UiText.TipExportJson}" Margin="0,0,8,4" />
          <Button Content="{x:Static local:UiText.ExportCsv}" Command="{Binding ExportCsvCommand}" ToolTip.Tip="{x:Static local:UiText.TipExportCsv}" Margin="0,0,8,4" />
          <Button Content="{Binding ModeText}" Command="{Binding RequestModeChangeCommand}" ToolTip.Tip="{x:Static local:UiText.TipMode}" Margin="0,0,8,4" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
            <Button Classes="accent" Content="{x:Static local:UiText.StartDemo}" Command="{Binding StartDemoCommand}" ToolTip.Tip="{x:Static local:UiText.TipRunSimulation}" Margin="0,0,8,0" />
            <Button Content="{x:Static local:UiText.StopSimulation}" Command="{Binding StopSimulationCommand}" ToolTip.Tip="{x:Static local:UiText.TipStop}" Margin="0,0,8,0" />
            <Button Content="{x:Static local:UiText.ContinueSimulation}" Command="{Binding ContinueSimulationCommand}" ToolTip.Tip="{x:Static local:UiText.TipContinue}" Margin="0,0,8,0" />
            <Button Content="{x:Static local:UiText.ResetSimulation}" Command="{Binding ResetSimulationCommand}" ToolTip.Tip="{x:Static local:UiText.TipResetSimulation}" />
          </StackPanel>
        </WrapPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1">
      <Border IsVisible="{Binding ModeConfirmationVisible}" Background="#3A2A12" Padding="16,10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel>
            <TextBlock Text="{x:Static local:UiText.ModeConfirmTitle}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static local:UiText.ModeConfirmBody}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Classes="accent" Content="{x:Static local:UiText.Confirm}" Command="{Binding ConfirmModeChangeCommand}" ToolTip.Tip="{x:Static local:UiText.TipConfirmMode}" />
          <Button Grid.Column="2" Content="{x:Static local:UiText.Cancel}" Command="{Binding CancelModeChangeCommand}" ToolTip.Tip="{x:Static local:UiText.TipCancelMode}" />
        </Grid>
      </Border>
      <Border IsVisible="{Binding LoadExampleConfirmationVisible}" Background="#3A2A12" Padding="16,10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel>
            <TextBlock Text="{x:Static local:UiText.LoadExampleTitle}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static local:UiText.LoadExampleBody}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Classes="accent" Content="{x:Static local:UiText.LoadExampleConfirm}" Command="{Binding ConfirmLoadExampleCommand}" ToolTip.Tip="{x:Static local:UiText.TipConfirmLoadExample}" />
          <Button Grid.Column="2" Content="{x:Static local:UiText.Cancel}" Command="{Binding CancelLoadExampleCommand}" ToolTip.Tip="{x:Static local:UiText.TipCancelLoadExample}" />
        </Grid>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="196,*">
      <Border Background="#121A24" BorderBrush="#243140" BorderThickness="0,0,1,0" Padding="12,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="6">
            <TextBlock Text="{x:Static local:UiText.ValidationTitle}" Classes="section" />
            <TextBlock Text="{Binding IssueSummary}" Classes="muted" TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="220">
              <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" Foreground="#E7C27A" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <StackPanel Spacing="4">
            <Button Classes="nav" Classes.selected="{Binding IsLiveSelected}" Content="{x:Static local:UiText.NavLive}" Command="{Binding ShowPageCommand}" CommandParameter="Live" ToolTip.Tip="{x:Static local:UiText.TipNavLive}" />
            <Button Classes="nav" Classes.selected="{Binding IsLayoutSelected}" Content="{x:Static local:UiText.NavLayout}" Command="{Binding ShowPageCommand}" CommandParameter="Layout" ToolTip.Tip="{x:Static local:UiText.TipNavLayout}" />
            <Button Classes="nav" Classes.selected="{Binding IsArticlesSelected}" Content="{x:Static local:UiText.NavArticles}" Command="{Binding ShowPageCommand}" CommandParameter="Articles" ToolTip.Tip="{x:Static local:UiText.TipNavArticles}" />
            <Button Classes="nav" Classes.selected="{Binding IsOptimizerSelected}" Content="{x:Static local:UiText.NavOptimizer}" Command="{Binding ShowPageCommand}" CommandParameter="Optimizer" ToolTip.Tip="{x:Static local:UiText.TipNavOptimizer}" />
            <Button Classes="nav" Classes.selected="{Binding IsStudySelected}" Content="{x:Static local:UiText.NavStudy}" Command="{Binding ShowPageCommand}" CommandParameter="Study" ToolTip.Tip="{x:Static local:UiText.TipNavStudy}" />
            <Button Classes="nav" Classes.selected="{Binding IsOperationSelected}" Content="{x:Static local:UiText.NavOperation}" Command="{Binding ShowPageCommand}" CommandParameter="Operation" ToolTip.Tip="{x:Static local:UiText.TipNavOperation}" />
            <Button Classes="nav" Classes.selected="{Binding IsResultsSelected}" Content="{x:Static local:UiText.NavResults}" Command="{Binding ShowPageCommand}" CommandParameter="Results" ToolTip.Tip="{x:Static local:UiText.TipNavResults}" />
          </StackPanel>
        </DockPanel>
      </Border>
      <ContentControl Grid.Column="1" Margin="16" Content="{Binding CurrentPage}" />
    </Grid>
  </Grid>
</Window>
