<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShaftStockDistributor.Desktop.ViewModels"
        xmlns:local="using:ShaftStockDistributor.Desktop"
        x:Class="ShaftStockDistributor.Desktop.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="{x:Static local:UiText.AppTitle}"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#0E141B">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Background="#121A24" BorderBrush="#243140" BorderThickness="0,0,0,1" Padding="16,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{x:Static local:UiText.AppTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Classes="badge" IsVisible="{Binding IsExample}">
              <TextBlock Text="{x:Static local:UiText.ExampleBadge}" />
            </Border>
          </StackPanel>
          <TextBlock Text="{x:Static local:UiText.Tagline}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="980">
          <Button Content="{x:Static local:UiText.New}" Command="{Binding NewProjectCommand}" Margin="0,0,8,4" />
          <Button Content="{x:Static local:UiText.Open}" Command="{Binding OpenProjectCommand}" Margin="0,0,8,4" />
          <Button Content="{x:Static local:UiText.Save}" Command="{Binding SaveProjectCommand}" Margin="0,0,8,4" />
          <Button Content="{x:Static local:UiText.LoadExample}" Command="{Binding LoadExampleCommand}" Margin="0,0,8,4" />
          <Button Content="{x:Static local:UiText.ExportJson}" Command="{Binding ExportJsonCommand}" Margin="0,0,8,4" />
          <Button Content="{x:Static local:UiText.ExportCsv}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,4" />
          <Button Content="{Binding ModeText}" Command="{Binding RequestModeChangeCommand}" Margin="0,0,8,4" />
          <Button Classes="accent" Content="{x:Static local:UiText.StartDemo}" Command="{Binding StartDemoCommand}" IsEnabled="{Binding !Live.IsBusy}" Margin="0,0,0,4" />
        </WrapPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1">
      <Border IsVisible="{Binding ModeConfirmationVisible}" Background="#3A2A12" Padding="16,10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel>
            <TextBlock Text="{x:Static local:UiText.ModeConfirmTitle}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static local:UiText.ModeConfirmBody}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Classes="accent" Content="{x:Static local:UiText.Confirm}" Command="{Binding ConfirmModeChangeCommand}" />
          <Button Grid.Column="2" Content="{x:Static local:UiText.Cancel}" Command="{Binding CancelModeChangeCommand}" />
        </Grid>
      </Border>
      <Border IsVisible="{Binding LoadExampleConfirmationVisible}" Background="#3A2A12" Padding="16,10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel>
            <TextBlock Text="{x:Static local:UiText.LoadExampleTitle}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static local:UiText.LoadExampleBody}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Classes="accent" Content="{x:Static local:UiText.LoadExampleConfirm}" Command="{Binding ConfirmLoadExampleCommand}" />
          <Button Grid.Column="2" Content="{x:Static local:UiText.Cancel}" Command="{Binding CancelLoadExampleCommand}" />
        </Grid>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="196,*">
      <Border Background="#121A24" BorderBrush="#243140" BorderThickness="0,0,1,0" Padding="12,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="6">
            <TextBlock Text="{x:Static local:UiText.ValidationTitle}" Classes="section" />
            <TextBlock Text="{Binding IssueSummary}" Classes="muted" TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="220">
              <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" Foreground="#E7C27A" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <StackPanel Spacing="4">
            <Button Classes="nav" Classes.selected="{Binding IsLiveSelected}" Content="{x:Static local:UiText.NavLive}" Command="{Binding ShowPageCommand}" CommandParameter="Live" />
            <Button Classes="nav" Classes.selected="{Binding IsLayoutSelected}" Content="{x:Static local:UiText.NavLayout}" Command="{Binding ShowPageCommand}" CommandParameter="Layout" />
            <Button Classes="nav" Classes.selected="{Binding IsArticlesSelected}" Content="{x:Static local:UiText.NavArticles}" Command="{Binding ShowPageCommand}" CommandParameter="Articles" />
            <Button Classes="nav" Classes.selected="{Binding IsOptimizerSelected}" Content="{x:Static local:UiText.NavOptimizer}" Command="{Binding ShowPageCommand}" CommandParameter="Optimizer" />
            <Button Classes="nav" Classes.selected="{Binding IsStudySelected}" Content="{x:Static local:UiText.NavStudy}" Command="{Binding ShowPageCommand}" CommandParameter="Study" />
            <Button Classes="nav" Classes.selected="{Binding IsOperationSelected}" Content="{x:Static local:UiText.NavOperation}" Command="{Binding ShowPageCommand}" CommandParameter="Operation" />
          </StackPanel>
        </DockPanel>
      </Border>
      <ContentControl Grid.Column="1" Margin="16" Content="{Binding CurrentPage}" />
    </Grid>
  </Grid>
</Window>
