@page "/"
@rendermode InteractiveServer
@inject PlanningSession Session
@inject IJSRuntime Js

<PageTitle>ShaftStockDistributor</PageTitle>

@{
    RefreshDemand();
}

<section class="toolbar">
    <button type="button" @onclick="LoadExample" disabled="@_busy">Load example</button>
    <button type="button" @onclick="RunOptimize" disabled="@_busy">Run optimizer</button>
    <label class="check"><input type="checkbox" @bind="_keepCurrent" /> Keep current shafts</label>
    <button type="button" @onclick="RunSimulation" disabled="@_busy">Run simulation</button>
    <label>Hours <input type="number" min="0.1" step="0.5" @bind="_hours" /></label>
    <label>Seed <input type="number" @bind="_seed" /></label>
    <label class="check"><input type="checkbox" @bind="_heatmap" /> Pull heatmap</label>
    <button type="button" @onclick="ExportAssignment" disabled="@_busy">Export assignment</button>
</section>

<section class="toolbar secondary">
    <label class="file">Layout <InputFile OnChange="ImportLayout" /></label>
    <label class="file">Articles <InputFile OnChange="ImportArticles" /></label>
    <label class="file">Assignment <InputFile OnChange="ImportAssignment" /></label>
    <label class="file">Parameters <InputFile OnChange="ImportParameters" /></label>
</section>

@if (!string.IsNullOrWhiteSpace(Session.Status))
{
    <p class="status">@Session.Status</p>
}
@if (!string.IsNullOrWhiteSpace(_error))
{
    <p class="status error">@_error</p>
}
@if (Session.Layout.ExampleData || Session.Articles.ExampleData)
{
    <p class="status note">Example data is loaded. Names, inflows, pallet sizes, and capacities are assumptions for the prototype.</p>
}

@{
    var messages = Session.Validate();
    var errors = messages.Where(message => message.IsError).ToList();
}
@if (errors.Count > 0)
{
    <ul class="messages">
        @foreach (var message in errors.Take(8))
        {
            <li>@message.Text</li>
        }
        @if (errors.Count > 8)
        {
            <li>@($"{errors.Count - 8} more validation errors.")</li>
        }
    </ul>
}

<section class="workspace">
    <div class="panel articles">
        <div class="panel-head">
            <h2>Articles</h2>
            <button type="button" @onclick="AddArticle">Add</button>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>ABC</th>
                        <th>Crates/h</th>
                        <th>Pallet</th>
                        <th>Offset</th>
                        <th>Capacity</th>
                        <th>Shafts</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var article in Session.Articles.Items)
                    {
                        var rowSelected = article.Id == _selectedArticleId;
                        var assigned = Session.Assignment.CountFor(article.Id);
                        var needed = _demand.GetValueOrDefault(article.Id);
                        <tr class="@(rowSelected ? "selected" : null)" draggable="true" @ondragstart="() => BeginArticleDrag(article.Id)" @onclick="() => _selectedArticleId = article.Id">
                            <td><input class="id" value="@article.Id" @onchange="e => Rename(article, e)" /></td>
                            <td><input value="@article.Name" @onchange="e => article.Name = e.Value?.ToString() ?? article.Name" /></td>
                            <td>
                                <select @bind="article.AbcClass">
                                    <option value="@AbcClass.A">A</option>
                                    <option value="@AbcClass.B">B</option>
                                    <option value="@AbcClass.C">C</option>
                                </select>
                            </td>
                            <td><input type="number" step="1" value="@article.CratesPerHour" @onchange="e => SetRate(article, e)" /></td>
                            <td><input type="number" @bind="article.CratesPerPallet" @bind:event="onchange" /></td>
                            <td><input type="number" @bind="article.Offset" @bind:event="onchange" /></td>
                            <td><input type="number" value="@article.ShaftCapacity" @onchange="e => SetCapacity(article, e)" /></td>
                            <td class="@(assigned < needed ? "short" : null)">@assigned / @needed</td>
                            <td><button type="button" class="ghost" @onclick="() => Remove(article.Id)" @onclick:stopPropagation="true">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="hint">Select a row, then click a shaft to assign it. Drag a row onto a shaft, or drag a shaft onto another shaft to move or swap. The shaft column is assigned / calculated demand. Clear crates/h to derive the rate from the ABC share.</p>
        <details>
            <summary>Planner settings</summary>
            <div class="settings">
                <label>Expected pull wait (s) <input type="number" @bind="Session.Parameters.ExpectedPullWaitSeconds" @bind:event="onchange" /></label>
                <label>Travel weight <input type="number" step="0.1" @bind="Session.Parameters.Weights.Travel" @bind:event="onchange" /></label>
                <label>Imbalance weight <input type="number" step="0.1" @bind="Session.Parameters.Weights.Imbalance" @bind:event="onchange" /></label>
                <label>Middle-traffic weight <input type="number" step="0.1" @bind="Session.Parameters.Weights.MiddleTraffic" @bind:event="onchange" /></label>
                <label>Annealing iterations <input type="number" @bind="Session.Parameters.Annealing.Iterations" @bind:event="onchange" /></label>
                <label>Annealing seed <input type="number" @bind="Session.Parameters.Annealing.Seed" @bind:event="onchange" /></label>
            </div>
        </details>
        <details>
            <summary>Rack size</summary>
            <div class="settings">
                <label>Segments <input type="number" min="1" @bind="_segments" /></label>
                <label>Levels <input type="number" min="1" max="5" @bind="_levels" /></label>
                <label>Shafts / level <input type="number" min="1" max="9" @bind="_shaftsPerLevel" /></label>
                <label>Default capacity <input type="number" min="1" @bind="_capacity" /></label>
                <button type="button" @onclick="ApplyGeometry">Apply size and clear assignment</button>
            </div>
        </details>
    </div>

    <div class="panel rack-panel">
        <div class="panel-head">
            <h2>Rack</h2>
            <div class="legend">
                <span class="zone z1">Shuttle 1 only</span>
                <span class="zone zshared">Shared middle</span>
                <span class="zone z2">Shuttle 2 only</span>
            </div>
        </div>
        @if (_selectedLocation is ShaftLocation selected && Session.Layout.Find(selected) is Shaft selectedShaft)
        {
            var assigned = Session.Assignment.TryGet(selected, out var current) ? current : null;
            <div class="inspector">
                <strong>@selected</strong>
                <span>@ZoneName(selectedShaft.Zone)</span>
                <select @bind="_inspectorArticle">
                    <option value="">(empty)</option>
                    @foreach (var article in Session.Articles.Items)
                    {
                        <option value="@article.Id">@article.Id</option>
                    }
                </select>
                <button type="button" @onclick="() => ApplyInspector(selected)">Apply</button>
                <label class="check"><input type="checkbox" checked="@(assigned?.Pinned == true)" @onchange="e => TogglePin(selected, e)" /> Pin</label>
                @if (_heatmap && Session.LastSimulation is not null)
                {
                    <span>@PullsOf(selected) pulls</span>
                }
            </div>
        }
        <div class="rack">
            @for (var segment = 0; segment < Session.Layout.SegmentCount; segment++)
            {
                var zone = Session.Layout.Zones.ZoneOf(segment);
                <section class="segment @ZoneClass(zone)">
                    <header>
                        <span>Segment @(segment + 1)</span>
                        <span>@ZoneName(zone)</span>
                    </header>
                    @for (var level = Session.Layout.LevelsPerSegment - 1; level >= 0; level--)
                    {
                        var levelIndex = level;
                        <div class="level">
                            <span class="level-label">L@(levelIndex + 1)</span>
                            @for (var shaftIndex = 0; shaftIndex < Session.Layout.ShaftsPerLevel; shaftIndex++)
                            {
                                var location = new ShaftLocation(segment, levelIndex, shaftIndex);
                                var shaftAssignment = Session.Assignment.TryGet(location, out var found) ? found : null;
                                var color = ShaftColor(location, shaftAssignment?.ArticleId);
                                <button type="button"
                                        class="shaft @(shaftAssignment?.Pinned == true ? "pinned" : null) @(location == _selectedLocation ? "current" : null)"
                                        style="background:@color"
                                        title="@ShaftTitle(location, shaftAssignment)"
                                        draggable="@(shaftAssignment is not null)"
                                        @ondragstart="() => BeginShaftDrag(location)"
                                        @ondragover:preventDefault="true"
                                        @ondrop="() => DropOn(location)"
                                        @onclick="() => ClickShaft(location)">
                                    @(shaftIndex + 1)
                                </button>
                            }
                        </div>
                    }
                </section>
            }
        </div>
        <div class="color-legend">
            @foreach (var article in Session.Articles.Items)
            {
                <span><i style="background:@ArticleColor(article.Id)"></i>@article.Id</span>
            }
        </div>

        @if (Session.LastOptimization is OptimizationResult optimization)
        {
            <div class="kpis">
                <article><span>Cost before search</span><strong>@optimization.ConstructiveCost.Total.ToString("0")</strong></article>
                <article><span>Cost after search</span><strong>@optimization.FinalCost.Total.ToString("0")</strong></article>
                <article><span>Shuttle load</span><strong>@optimization.FinalCost.LoadShuttle1.ToString("0") / @optimization.FinalCost.LoadShuttle2.ToString("0")</strong></article>
            </div>
        }
        @if (Session.LastSimulation is SimulationResult simulation)
        {
            <div class="kpis">
                <article><span>Pulls shuttle 1</span><strong>@simulation.PullsShuttle1</strong></article>
                <article><span>Pulls shuttle 2</span><strong>@simulation.PullsShuttle2</strong></article>
                <article><span>Utilization</span><strong>@Pct(simulation.UtilizationShuttle1) / @Pct(simulation.UtilizationShuttle2)</strong></article>
                <article><span>Blocked</span><strong>@simulation.BlockedSeconds.ToString("0") s</strong></article>
                <article><span>Avg / max wait</span><strong>@simulation.AveragePullWaitSeconds.ToString("0") / @simulation.MaxPullWaitSeconds.ToString("0") s</strong></article>
                <article><span>Rejected crates</span><strong>@simulation.RejectedCrates</strong></article>
                <article><span>Overflow events</span><strong>@simulation.OverflowEventsByArticle.Values.Sum()</strong></article>
                <article><span>Collisions</span><strong>@simulation.CollisionViolations</strong></article>
            </div>
            @if (simulation.OverflowEventsByArticle.Count > 0)
            {
                <p class="hint">Overflows: @string.Join(", ", simulation.OverflowEventsByArticle.OrderBy(pair => pair.Key).Select(pair => $"{pair.Key} {pair.Value}"))</p>
            }
        }
    </div>
</section>

@code {
    private bool _busy;
    private bool _keepCurrent;
    private bool _heatmap;
    private double _hours = 8;
    private int _seed = 1;
    private int _segments = 12;
    private int _levels = 5;
    private int _shaftsPerLevel = 9;
    private int _capacity = 48;
    private string? _error;
    private string? _selectedArticleId;
    private ShaftLocation? _selectedLocation;
    private string _inspectorArticle = "";
    private string? _dragArticleId;
    private ShaftLocation? _dragShaft;
    private SimulationResult? _pullSource;
    private Dictionary<string, int> _pulls = [];
    private IReadOnlyDictionary<string, int> _demand = new Dictionary<string, int>();

    protected override void OnInitialized()
    {
        SyncGeometry();
        RefreshDemand();
    }

    private void SyncGeometry()
    {
        _segments = Session.Layout.SegmentCount;
        _levels = Session.Layout.LevelsPerSegment;
        _shaftsPerLevel = Session.Layout.ShaftsPerLevel;
        _capacity = Session.Layout.DefaultShaftCapacity;
    }

    private void RefreshDemand() => _demand = Session.Demand();

    private void LoadExample()
    {
        Session.LoadExample();
        _selectedArticleId = null;
        _selectedLocation = null;
        _error = null;
        SyncGeometry();
        RefreshDemand();
    }

    private async Task RunOptimize()
    {
        await RunAsync(() => Session.Optimize(_keepCurrent));
        RefreshDemand();
    }

    private async Task RunSimulation()
    {
        if (_hours <= 0)
        {
            _error = "Simulation hours must be positive.";
            return;
        }

        await RunAsync(() => Session.Simulate(_hours, _seed));
    }

    private async Task RunAsync(Action action)
    {
        _busy = true;
        _error = null;
        await Task.Yield();
        try
        {
            action();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAssignment()
    {
        _error = null;
        try
        {
            await Js.InvokeVoidAsync("ssdDownload", "assignment.json", Session.AssignmentJson());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ImportLayout(InputFileChangeEventArgs change) => await Import(change, Session.ReplaceLayout);

    private async Task ImportArticles(InputFileChangeEventArgs change) => await Import(change, Session.ReplaceArticles);

    private async Task ImportAssignment(InputFileChangeEventArgs change) => await Import(change, Session.ReplaceAssignment);

    private async Task ImportParameters(InputFileChangeEventArgs change) => await Import(change, Session.ReplaceParameters);

    private async Task Import(InputFileChangeEventArgs change, Action<string> load)
    {
        _error = null;
        try
        {
            await using var stream = change.File.OpenReadStream(maxAllowedSize: 2_000_000);
            using var reader = new StreamReader(stream);
            load(await reader.ReadToEndAsync());
            SyncGeometry();
            RefreshDemand();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void AddArticle()
    {
        var article = Session.AddArticle();
        _selectedArticleId = article.Id;
        RefreshDemand();
    }

    private void Remove(string id)
    {
        Session.RemoveArticle(id);
        if (_selectedArticleId == id)
        {
            _selectedArticleId = null;
        }

        RefreshDemand();
    }

    private void Rename(Article article, ChangeEventArgs change)
    {
        Session.Rename(article, change.Value?.ToString() ?? "");
        _selectedArticleId = article.Id;
        RefreshDemand();
    }

    private static void SetRate(Article article, ChangeEventArgs change)
    {
        var text = change.Value?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            article.CratesPerHour = null;
            return;
        }

        if (double.TryParse(text, out var value))
        {
            article.CratesPerHour = value;
        }
    }

    private static void SetCapacity(Article article, ChangeEventArgs change)
    {
        var text = change.Value?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            article.ShaftCapacity = null;
            return;
        }

        if (int.TryParse(text, out var value))
        {
            article.ShaftCapacity = value;
        }
    }

    private void ApplyGeometry()
    {
        _error = null;
        try
        {
            Session.ApplyGeometry(_segments, _levels, _shaftsPerLevel, _capacity);
            _selectedLocation = null;
            RefreshDemand();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ClickShaft(ShaftLocation location)
    {
        _selectedLocation = location;
        _inspectorArticle = Session.Assignment.TryGet(location, out var assignment) ? assignment.ArticleId : _selectedArticleId ?? "";
        if (!string.IsNullOrWhiteSpace(_selectedArticleId))
        {
            Session.AssignShaft(location, _selectedArticleId, pinned: false);
            _inspectorArticle = _selectedArticleId;
            RefreshDemand();
        }
    }

    private void ApplyInspector(ShaftLocation location)
    {
        var pinned = Session.Assignment.TryGet(location, out var assignment) && assignment.Pinned;
        Session.AssignShaft(location, string.IsNullOrWhiteSpace(_inspectorArticle) ? null : _inspectorArticle, pinned);
        RefreshDemand();
    }

    private void TogglePin(ShaftLocation location, ChangeEventArgs change)
    {
        var pinned = change.Value is bool value && value;
        Session.SetPinned(location, pinned);
    }

    private void BeginArticleDrag(string articleId)
    {
        _dragArticleId = articleId;
        _dragShaft = null;
        _selectedArticleId = articleId;
    }

    private void BeginShaftDrag(ShaftLocation location)
    {
        _dragShaft = location;
        _dragArticleId = null;
    }

    private void DropOn(ShaftLocation location)
    {
        if (_dragArticleId is not null)
        {
            Session.AssignShaft(location, _dragArticleId, pinned: false);
        }
        else if (_dragShaft is ShaftLocation from)
        {
            Session.MoveOrSwap(from, location);
        }

        _dragArticleId = null;
        _dragShaft = null;
        _selectedLocation = location;
        RefreshDemand();
    }

    private string ShaftColor(ShaftLocation location, string? articleId)
    {
        if (_heatmap && Session.LastSimulation is not null)
        {
            var pulls = PullsOf(location);
            var max = _pulls.Count == 0 ? 0 : _pulls.Values.Max();
            if (max <= 0)
            {
                return "#eceae4";
            }

            var lightness = 92 - (int)(40.0 * pulls / max);
            return $"hsl(12 72% {lightness}%)";
        }

        return articleId is null ? "#f7f6f3" : ArticleColor(articleId);
    }

    private int PullsOf(ShaftLocation location)
    {
        var simulation = Session.LastSimulation;
        if (!ReferenceEquals(simulation, _pullSource))
        {
            _pullSource = simulation;
            _pulls = simulation is null
                ? []
                : simulation.ShaftPulls.ToDictionary(shaft => $"{shaft.Segment}:{shaft.Level}:{shaft.Shaft}", shaft => shaft.Pulls);
        }

        return _pulls.GetValueOrDefault(location.Key);
    }

    private string ShaftTitle(ShaftLocation location, ShaftAssignment? assignment)
    {
        var article = assignment is null ? "empty" : assignment.ArticleId;
        var pin = assignment?.Pinned == true ? ", pinned" : "";
        var pulls = Session.LastSimulation is null ? "" : $", {PullsOf(location)} pulls";
        return $"{location} {article}{pin}{pulls}";
    }

    private static string ArticleColor(string id)
    {
        var hash = 17;
        foreach (var character in id)
        {
            hash = unchecked((hash * 31) + character);
        }

        var hue = Math.Abs(hash % 360);
        return $"hsl({hue} 45% 72%)";
    }

    private static string ZoneName(Zone zone) => zone switch
    {
        Zone.Shuttle1Only => "Shuttle 1",
        Zone.Shuttle2Only => "Shuttle 2",
        _ => "Shared"
    };

    private static string ZoneClass(Zone zone) => zone switch
    {
        Zone.Shuttle1Only => "z1",
        Zone.Shuttle2Only => "z2",
        _ => "zshared"
    };

    private static string Pct(double value) => $"{value * 100:0}%";
}
